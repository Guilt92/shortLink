#!/usr/bin/env bash
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RESET='\033[0m'

check_docker_compose() {
  command -v docker-compose >/dev/null
}

start_services() {
  local dir
  dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  cd "$dir"
  echo -e "${YELLOW}Starting services...${RESET}"
  docker-compose up -d
}

wait_for_db() {
  local retries=10
  echo -e "${YELLOW}Waiting for PostgreSQL to become ready...${RESET}"
  until docker exec "$(docker-compose ps -q db)" pg_isready -U postgres >/dev/null 2>&1; do
    ((retries--)) || {
      echo -e "${RED}Error: db did not become ready${RESET}"
      exit 1
    }
    sleep 2
  done
  echo -e "${GREEN}PostgreSQL is ready!${RESET}"
}

show_status() {
  echo -e "${YELLOW}Current container status:${RESET}"
  docker-compose ps
}

main() {
  if ! check_docker_compose; then
    echo -e "${RED}Error: docker-compose not found${RESET}"
    exit 1
  fi
  start_services
  wait_for_db
  show_status
}

main "$@"
