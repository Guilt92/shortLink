#!/usr/bin/env bash
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RESET='\033[0m'


check_root()
{
	if [ "$EUID" -ne 0 ];then 
		echo -e "${RED}This script must be run as root. Please switch to the root user and try again.${RESET}"
		exit 1
	fi
}

check_root


install_depend() {
    local packages=(
        docker
        docker.io
        docker-ce
        docker-compose 
        docker-compose-plugin
    )

    echo -e "${YELLOW}Checking and installing Docker components...${RESET}"

    for pkg in "${packages[@]}"; do
        echo -e "${YELLOW}Checking if $pkg is installed...${RESET}"

        if ! dpkg -l | grep -qw "$pkg"; then
            echo -e "${YELLOW}$pkg not found. Installing...${RESET}"
            if ! apt-get install -y "$pkg"; then
                echo -e "${RED}Failed to install $pkg. Exiting.${RESET}"
                exit 1
            fi
            echo -e "${GREEN}$pkg installed successfully.${RESET}"
        else
            echo -e "${GREEN}$pkg is already installed.${RESET}"
        fi
    done

    echo -e "${GREEN}All Docker components are installed and ready.${RESET}"
}

install_depend

start_services() {
  sleep 1 
  celar 
  local dir
  dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  cd "$dir"
  echo -e "${YELLOW}Starting services...${RESET}"
  docker-compose up -d
}


wait_for_db() {
  sleep 1
  clear 
  local retries=10
  echo -e "${YELLOW}Waiting for PostgreSQL to become ready...${RESET}"
  until docker exec "$(docker-compose ps -q db)" pg_isready -U postgres >/dev/null 2>&1; do
    ((retries--)) || {
      echo -e "${RED}Error: db did not become ready${RESET}"
      exit 1
    }
    sleep 2
  done
  echo -e "${GREEN}PostgreSQL is ready!${RESET}"
}

show_status() {
  echo -e "${YELLOW}Current container status:${RESET}"
  docker-compose ps
}

main() {
  start_services
  wait_for_db
  show_status
}

main "$@"
