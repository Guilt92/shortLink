#!/usr/bin/env bash
set -euo pipefail

check_docker_compose() {
  command -v docker-compose >/dev/null
}

start_services() {
  local dir
  dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  cd "$dir"
  docker-compose up -d
}

wait_for_db() {
  local retries=10
  until docker exec "$(docker-compose ps -q db)" pg_isready -U postgres >/dev/null 2>&1; do
    ((retries--)) || {
      echo "db did not become ready"
      exit 1
    }
    sleep 2
  done
}

show_status() {
  docker-compose ps
}

main() {
  if ! check_docker_compose; then
    echo "docker-compose not found"
    exit 1
  fi
  start_services
  wait_for_db
  show_status
}

main "$@"
