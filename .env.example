# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://shortlink:CHANGE_ME@localhost:5432/shortlink
POSTGRES_USER=shortlink
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=shortlink

# Public origin used to build short URLs and reset links (no trailing slash).
PUBLIC_BASE_URL=http://localhost:3000
# Set true behind a reverse proxy that appends X-Forwarded-For (rate limiting uses the rightmost entry).
TRUST_PROXY=false
# Defaults to true when PUBLIC_BASE_URL is https.
# COOKIE_SECURE=true
# SESSION_TTL_DAYS=14
# DB_MAX_CONNECTIONS=20
# Secret salt for hashing visitor IPs (unique-visitor counts). Random per start if unset.
# VISITOR_SALT=
# "log" writes password-reset links to the server log (development only; no SMTP transport is bundled).
# MAIL_MODE=log

# Optional: creates a super admin on first start if the email does not exist yet.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-strong-password-1
